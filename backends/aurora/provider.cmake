# Optional GPL dependency/profile; importing this file never creates a backend.
function(recomp_audio_add_aurora_backend gxruntime)
  cmake_parse_arguments(profile "ROLLBACK" "" "" ${ARGN})
  if(profile_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown Aurora profile arguments")
  endif()
  if(NOT TARGET SDL3::SDL3)
    message(FATAL_ERROR "The optional Aurora GPL backend requires SDL3::SDL3")
  endif()
  set(_profile_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  get_filename_component(_audio_root "${_profile_root}/../.." ABSOLUTE)
  foreach(input IN ITEMS aurora_audio.cpp audio_stretch.hpp)
    set(file "${gxruntime}/backends/aurora/${input}")
    if(NOT EXISTS "${file}")
      message(FATAL_ERROR "Missing pinned Aurora GPL source: ${input}")
    endif()
    file(READ "${file}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 digest "${content}")
    if(input STREQUAL "aurora_audio.cpp")
      set(expected e0f909e67386190a2daece34202b37c532cad672450d261bca3de0d6d03f58f2)
    else()
      set(expected 2a6f4a17e1e70576a9ea4f1544503e1e13136f403cb339b6f37ee8848a2840b9)
    endif()
    if(NOT digest STREQUAL expected)
      message(FATAL_ERROR "Aurora GPL input differs from qualified RecompCore338a3d: ${input}")
    endif()
  endforeach()
  if(TARGET recomp_audio_aurora_gpl)
    get_target_property(selected recomp_audio_aurora_gpl RECOMP_AUDIO_AURORA_ROLLBACK)
    if(NOT "${selected}" STREQUAL "${profile_ROLLBACK}")
      message(FATAL_ERROR "Conflicting Aurora rollback profiles in one build")
    endif()
    return()
  endif()
  include("${_profile_root}/adapt.cmake")
  add_library(recomp_audio_aurora_gpl STATIC EXCLUDE_FROM_ALL
    "${_profile_root}/session.cpp" "${RECOMP_AUDIO_ADAPTED_AURORA}")
  add_library(recomp-audio::aurora-gpl ALIAS recomp_audio_aurora_gpl)
  target_include_directories(recomp_audio_aurora_gpl PUBLIC "${_audio_root}/include"
    PRIVATE "${gxruntime}/backends/aurora")
  target_compile_features(recomp_audio_aurora_gpl PRIVATE cxx_std_20)
  target_link_libraries(recomp_audio_aurora_gpl PRIVATE SDL3::SDL3)
  set_target_properties(recomp_audio_aurora_gpl PROPERTIES
    RECOMP_AUDIO_AURORA_ROLLBACK "${profile_ROLLBACK}"
    RECOMP_AUDIO_ADAPTED_SOURCE "${RECOMP_AUDIO_ADAPTED_AURORA}")
  if(profile_ROLLBACK)
    target_compile_definitions(recomp_audio_aurora_gpl PUBLIC RECOMP_AUDIO_AURORA_ROLLBACK=1)
  endif()
endfunction()
